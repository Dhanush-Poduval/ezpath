# AccessPath Frontend Environment Variables
# Running in Demo Mode by default (deterministic client-side graph solver & BroadcastChannel sync)
VITE_DEMO_MODE=true

# AWS Integration (Set VITE_DEMO_MODE=false to connect to AWS Backend)
VITE_API_BASE_URL=https://api.accesspath.transit.aws.internal
VITE_AWS_REGION=ap-south-1
VITE_LOCATION_MAP_NAME=AccessPathDefaultMap
VITE_COGNITO_USER_POOL_ID=ap-south-1_accesspath
VITE_COGNITO_CLIENT_ID=client_id_placeholder
VITE_APPSYNC_EVENTS_URL=https://events.accesspath.transit.aws.internal

