{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/route-response.schema.json",
  "title": "Accessible Routing Response",
  "type": "object",
  "required": ["request_id", "status", "graph", "snapped_points", "routes", "message"],
  "properties": {
    "request_id": {"type": ["string", "null"]},
    "status": {"type": "string", "enum": ["ok", "no_route"]},
    "graph": {"type": "object", "required": ["version", "source", "crs"]},
    "snapped_points": {"type": "object", "required": ["origin", "destination"]},
    "routes": {"type": "array", "items": {
      "type": "object", "required": ["route_id", "nodes", "edges", "metrics", "accessibility", "geometry", "diagnostics"],
      "properties": {
        "route_id": {"type": "string"},
        "nodes": {"type": "array"},
        "edges": {"type": "array"},
        "metrics": {"type": "object", "required": ["duration_min", "walking_distance_m", "uncertainty_points", "unknown_accessibility_edges", "transfer_count"]},
        "accessibility": {"type": "object", "required": ["status", "policy", "wheelchair_profile", "warnings"]},
        "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"const": "LineString"}, "coordinates": {"type": "array", "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}}},
        "diagnostics": {"type": "object"}
      }
    }},
    "message": {"type": ["string", "null"]}
  }
}
